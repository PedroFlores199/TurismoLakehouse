{
  "name": "TurismoMetadataIngest",
  "properties": {
    "activities": [
      {
        "name": "ReadMetadata",
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings"
            },
            "formatSettings": {
              "type": "JsonReadSettings"
            }
          },
          "dataset": {
            "referenceName": "SourceMetadata",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "IngestSources",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "ReadMetadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "type": "Expression",
            "value": "@activity('ReadMetadata').output.value"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "DownloadTable",
              "type": "Copy",
              "policy": {
                "timeout": "00:10:00",
                "retry": 3,
                "retryIntervalInSeconds": 30
              },
              "typeProperties": {
                "source": {
                  "type": "RestSource",
                  "requestMethod": "GET",
                  "httpRequestTimeout": "00:02:00",
                  "requestInterval": "00.00:00:02"
                },
                "sink": {
                  "type": "JsonSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  },
                  "formatSettings": {
                    "type": "JsonWriteSettings",
                    "filePattern": "arrayOfObjects"
                  }
                }
              },
              "inputs": [
                {
                  "referenceName": "IneSource",
                  "type": "DatasetReference",
                  "parameters": {
                    "table_id": {
                      "type": "Expression",
                      "value": "@item().table_id"
                    },
                    "months": {
                      "type": "Expression",
                      "value": "@item().months"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "LandingJson",
                  "type": "DatasetReference",
                  "parameters": {
                    "table_id": {
                      "type": "Expression",
                      "value": "@item().table_id"
                    },
                    "months": "60"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "name": "MedallionTransform",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "IngestSources",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "linkedServiceName": {
          "referenceName": "DatabricksManagedIdentity",
          "type": "LinkedServiceReference"
        },
        "policy": {
          "timeout": "01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60
        },
        "typeProperties": {
          "notebookPath": "/Shared/turismo/medallion",
          "baseParameters": {
            "root": "/Volumes/turismo/bronze/landing",
            "catalog": "turismo"
          }
        }
      }
    ],
    "annotations": [
      "Metadata driven",
      "INE public data"
    ]
  }
}
