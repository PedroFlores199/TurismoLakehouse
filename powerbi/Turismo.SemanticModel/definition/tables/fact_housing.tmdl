table fact_housing

	measure 'Viviendas turísticas última observación' = VAR LastDate = MAX(fact_housing[period_start]) RETURN CALCULATE(SUM(fact_housing[homes]), fact_housing[period_start] = LastDate)
		formatString: #,0
		displayFolder: Indicadores

	column province
		dataType: string
		summarizeBy: none
		sourceColumn: province

	column period_start
		dataType: dateTime
		summarizeBy: none
		sourceColumn: period_start
		formatString: yyyy-MM-dd
		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column homes
		dataType: double
		summarizeBy: none
		sourceColumn: homes

	column beds
		dataType: double
		summarizeBy: none
		sourceColumn: beds

	column beds_per_home
		dataType: double
		summarizeBy: none
		sourceColumn: beds_per_home

	partition fact_housing = m
		mode: import
		source =
			let
			    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/PedroFlores199/TurismoLakehouse/main/data/gold/fact_housing.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"province", type text}, {"period_start", type date}, {"year", Int64.Type}, {"homes", type number}, {"beds", type number}, {"beds_per_home", type number}}, "en-US")
			in
			    Typed
