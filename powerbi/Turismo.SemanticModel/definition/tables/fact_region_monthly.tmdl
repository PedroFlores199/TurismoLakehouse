table fact_region_monthly

	measure 'Gasto internacional regional' = SUM(fact_region_monthly[spend_eur])
		formatString: #,0 €
		displayFolder: Indicadores

	measure 'Turistas internacionales' = SUM(fact_region_monthly[international_tourists])
		formatString: #,0
		displayFolder: Indicadores

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column period_start
		dataType: dateTime
		summarizeBy: none
		sourceColumn: period_start
		formatString: yyyy-MM-dd
		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column international_tourists
		dataType: double
		summarizeBy: none
		sourceColumn: international_tourists

	column spend_eur
		dataType: double
		summarizeBy: none
		sourceColumn: spend_eur

	column spend_per_person_eur
		dataType: double
		summarizeBy: none
		sourceColumn: spend_per_person_eur

	column daily_spend_eur
		dataType: double
		summarizeBy: none
		sourceColumn: daily_spend_eur

	column mean_trip_days
		dataType: double
		summarizeBy: none
		sourceColumn: mean_trip_days

	partition fact_region_monthly = m
		mode: import
		source =
			let
			    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/PedroFlores199/TurismoLakehouse/main/data/gold/fact_region_monthly.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"region", type text}, {"period_start", type date}, {"year", Int64.Type}, {"international_tourists", type number}, {"spend_eur", type number}, {"spend_per_person_eur", type number}, {"daily_spend_eur", type number}, {"mean_trip_days", type number}}, "en-US")
			in
			    Typed
