table dim_date
	dataCategory: Time

	column date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date
		isKey
		formatString: yyyy-MM-dd
		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		summarizeBy: none
		sourceColumn: month

	column quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

	partition dim_date = m
		mode: import
		source =
			let
			    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/PedroFlores199/TurismoLakehouse/main/data/gold/dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"date", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"quarter", Int64.Type}}, "en-US")
			in
			    Typed
