table dim_year

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year
		isKey

	partition dim_year = m
		mode: import
		source =
			let
			    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/PedroFlores199/TurismoLakehouse/main/data/gold/dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Selected = Table.Distinct(Table.SelectColumns(Headers, {"year"})),
			    Typed = Table.TransformColumnTypes(Selected, {{"year", Int64.Type}}, "en-US")
			in
			    Typed
